{
  "name": "nightowl",
  "version": "2.0.0",
  "description": "NightOwl - Cross-platform device curfew system",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/daemon",
    "packages/desktop"
  ],
  "scripts": {
    "build": "npm run build -ws",
    "build:shared": "npm run build -w packages/shared",
    "build:daemon": "npm run build -w packages/daemon",
    "build:desktop": "npm run build -w packages/desktop",
    "dev": "npm run build:shared && npm run build:daemon && npm run dev -w packages/desktop",
    "dev:desktop": "npm run dev -w packages/desktop",
    "dev:daemon": "NIGHTOWL_TEST_MODE=1 npm run dev -w packages/daemon",
    "test": "npm run test -ws --if-present",
    "test:shared": "npm run test -w packages/shared",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo dist",
    "package": "npm run build && npm run package -w packages/desktop",
    "package:mac": "npm run build && npm run package:mac -w packages/desktop",
    "package:win": "npm run build && npm run package:win -w packages/desktop",
    "package:dir": "npm run build && npm run package:dir -w packages/desktop"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "express": "^5.2.1"
  }
}
