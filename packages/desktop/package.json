{
  "name": "@nightowl/desktop",
  "version": "2.0.0",
  "description": "NightOwl Desktop App - Cross-platform device curfew system",
  "main": "dist/main/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-assets",
    "copy-assets": "cp -r src/renderer dist/ && cp src/preload.cjs dist/",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac",
    "package:win": "electron-builder --win",
    "package:dir": "electron-builder --dir"
  },
  "dependencies": {
    "@nightowl/shared": "2.0.0",
    "electron-store": "^8.1.0",
    "sudo-prompt": "^9.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3"
  },
  "build": {
    "appId": "com.nightowl.app",
    "productName": "NightOwl",
    "directories": {
      "output": "../../dist"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../daemon/dist",
        "to": "daemon",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icons/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.plist",
      "entitlementsInherit": "resources/entitlements.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icons/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "resources/icons/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "electronVersion": "28.3.3"
  }
}
