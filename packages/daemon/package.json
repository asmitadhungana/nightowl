{
  "name": "@nightowl/daemon",
  "version": "2.0.0",
  "description": "NightOwl Daemon - Curfew enforcement service",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "nightowld": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "NIGHTOWL_TEST_MODE=1 node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "package": "pkg dist/index.js --target node18 --output dist/nightowld"
  },
  "dependencies": {
    "@nightowl/shared": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "node-windows": "^1.0.0-beta.8"
  }
}
