{
  "name": "@nightowl/daemon",
  "version": "2.0.0",
  "description": "NightOwl Daemon - Curfew enforcement service",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "nightowld": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "NIGHTOWL_TEST_MODE=1 node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist *.tsbuildinfo",
    "bundle:cjs": "esbuild dist/index.js --bundle --platform=node --format=cjs --target=node20 --external:bcrypt --outfile=dist/nightowld.cjs",
    "package:win": "npm run build && npm run bundle:cjs && pkg dist/nightowld.cjs --targets node20-win-x64 --output dist/nightowld.exe",
    "package:win:compressed": "npm run build && npm run bundle:cjs && pkg dist/nightowld.cjs --targets node20-win-x64 --compress GZip --output dist/nightowld.exe"
  },
  "dependencies": {
    "@nightowl/shared": "2.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@yao-pkg/pkg": "^5.16.1",
    "esbuild": "^0.24.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
